---
import ActionButton from "@views/components/ActionButton.astro"
import SplitSection from "@views/components/SplitSection.astro"
import type { CardDealContent } from "@models/landing.model"

interface Props {
    content: CardDealContent
}

const { content } = Astro.props
---

<SplitSection>
    <Fragment slot="info">
        <div class="flex flex-col items-start gap-5">
            <h2 class="heading-2">
                <span>{content.headingLineOne}</span>
                <span>{content.headingLineTwo}</span>
            </h2>
            <p class="paragraph max-w-copy">{content.description}</p>
            <ActionButton label={content.ctaLabel} href={content.ctaHref} className="mt-5" />
        </div>
    </Fragment>

    <Fragment slot="media">
        <img
            src={content.image.src}
            alt={content.image.alt}
            width={content.image.width}
            height={content.image.height}
            loading="lazy"
            class="relative z-5 w-full h-auto"
        />
    </Fragment>
</SplitSection>

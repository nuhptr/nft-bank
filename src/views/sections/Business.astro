---
import ActionButton from "@views/components/ActionButton.astro"
import FeatureCard from "@views/components/FeatureCard.astro"
import SplitSection from "@views/components/SplitSection.astro"
import type { BusinessContent, FeatureItem } from "@models/landing.model"

interface Props {
    content: BusinessContent
    features: readonly FeatureItem[]
}

const { content, features } = Astro.props
---

<SplitSection id={content.id} stackedMedia>
    <Fragment slot="info">
        <div class="flex flex-col items-start gap-5">
            <h2 class="heading-2">
                <span>{content.headingLineOne}</span>
                <span>{content.headingLineTwo}</span>
            </h2>
            <p class="paragraph max-w-copy">{content.description}</p>
            <ActionButton label={content.ctaLabel} href={content.ctaHref} className="mt-5" />
        </div>
    </Fragment>

    <div slot="media" class="flex flex-col gap-6 w-full">
        {features.map((feature) => (
            <FeatureCard feature={feature} />
        ))}
    </div>
</SplitSection>

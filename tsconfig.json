{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "paths": {
            "@models/*": ["./src/models/*"],
            "@viewmodels/*": ["./src/viewmodels/*"],
            "@views/*": ["./src/views/*"],
            "@styles/*": ["./src/styles/*"]
        }
    }
}
